    "micropad-ui": "^0.0.1",
    "mobx": "^7.0.3",
    "node-nowplaying": "^0.1.0",
    "pulseaudio.js": "^1.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "optionalDependencies": {
    "nowplaying-darwin-universal": "npm:node-nowplaying-darwin-universal@0.1.0",
    "nowplaying-linux-arm64-gnu": "npm:node-nowplaying-linux-arm64-gnu@0.1.0",
    "nowplaying-linux-arm64-musl": "npm:node-nowplaying-linux-arm64-musl@0.1.0",
