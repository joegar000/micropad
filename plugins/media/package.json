{
  "name": "micropad-plugin-media",
  "version": "1.0.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./client": "./dist/client.js",
    "./server": "./dist/server.js",
    "./manifest": "./manifest.json"
  },
  "files": [
    "dist",
    "manifest.json",
